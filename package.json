{
  "name": "cataloggy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "TheShield2594",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @cataloggy/shared build && pnpm -r typecheck",
    "lint": "pnpm --filter @cataloggy/shared build && eslint eslint.config.mjs scripts apps/web/scripts && pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "check:env": "node scripts/check-compose-env.mjs",
    "version:set": "node scripts/set-version.mjs",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
