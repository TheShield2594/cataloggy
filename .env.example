# Copy this file to .env (next to docker-compose.yml) and fill in real values
# before running `docker compose up`. See README.md for full details.

# ── Required ──────────────────────────────────────────────────────────────

# Shared bearer token used by the api and addon services to authenticate
# requests. Generate one with: openssl rand -hex 32
#
# It is also what the stored-credential encryption key is derived from, so
# changing it later means reconnecting Trakt/Stremio and re-entering your API
# keys — see "Secrets at rest" in README.md before rotating it.
API_TOKEN=

# Postgres password for the db service. Must not be left as the old
# "postgres" development default in production.
POSTGRES_PASSWORD=

# ── Recommended: pin the image version ────────────────────────────────────

# Tag used for all four Cataloggy images (api, addon, web, migrate). Unset
# means `latest`, which always follows the most recent build from main — so
# `docker compose pull` can move you onto an untested build with nothing to
# roll back to. Pin it once the stack works: every build is also published as
# `sha-<short-sha>`, and tagged releases as `vX.Y.Z`. Roll back by setting the
# previous tag here and running `docker compose pull && docker compose up -d`.
CATALOGGY_IMAGE_TAG=

# ── Recommended for LAN devices (phone / Apple TV / Android TV) ───────────

# Replace 192.168.1.25 below with your machine's LAN IP (see README.md
# "Find your LAN IP").
CATALOGGY_ALLOWED_ORIGINS=http://192.168.1.25:7002
CATALOGGY_API_PUBLIC=http://192.168.1.25:7000
CATALOGGY_WEB_PUBLIC=http://192.168.1.25:7002
ADDON_PUBLIC_BASE=http://192.168.1.25:7001
VITE_API_BASE=http://192.168.1.25:7000
VITE_ADDON_BASE=http://192.168.1.25:7001

# ── Optional: custom domain (e.g. behind Nginx Proxy Manager) ─────────────

# Comma-separated hostnames allowed to reach the web server, beyond
# IPs/localhost (which are always allowed).
ALLOWED_HOSTS=

# ── Optional: behind a reverse proxy ──────────────────────────────────────

# Which proxies the api and addon services may believe about the client's
# address. Unset trusts none of them, which is right when nothing sits in
# front of Cataloggy — but behind a proxy it makes every request arrive as
# the proxy's own IP, so the whole household shares one 200/min rate-limit
# budget and WEBHOOK_ALLOWED_IPS below can never match.
#
# Set it to a comma-separated list of proxy IPs/CIDRs — the addresses the api
# container sees the proxy connect from, which is its address on the Docker
# network rather than its LAN address. `172.16.0.0/12` covers the default
# Docker bridge range and is the usual working answer; `docker compose exec
# api getent hosts <proxy-container>` tells you the exact one.
#
# Do NOT set it to "true". That trusts the entire X-Forwarded-For chain, and
# Nginx's $proxy_add_x_forwarded_for appends to whatever the client already
# sent rather than replacing it — so any client could prepend an address of
# its choosing, become that IP for rate-limiting purposes, and walk straight
# through WEBHOOK_ALLOWED_IPS. Naming the proxy bounds the trust to the one
# hop you actually control.
TRUST_PROXY=

# Path prefixes each service is mounted under, if the proxy routes by path
# (e.g. https://home.example.com/api/... rather than a subdomain each). The
# prefix is stripped before routing. Two variables rather than one because the
# defaults differ, and because giving the api /addon would break it: the api
# serves its own built-in Stremio manifest under that path and would strip
# those routes away.
API_PROXY_PATH_PREFIXES=/api
ADDON_PROXY_PATH_PREFIXES=/addon

# ── Optional integrations ──────────────────────────────────────────────────

# Seeds the TMDB key for a fresh deployment. It can also be set (and changed
# afterwards) in the app under Settings → TMDB Metadata, which overrides this.
TMDB_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=

# Let a removal on Trakt remove the item from your local watchlist too.
# Off by default: Trakt is a mirror, not the system of record, so it can add to
# your library but never subtract from it. Set to "true" only if you want Trakt
# driving your watchlist. Either way, a Trakt watchlist that has gone entirely
# empty is treated as a fault and never mirrored.
TRAKT_WATCHLIST_MIRROR_DELETES=false

# Stremio watched sync. Reads watched state straight from your Stremio account,
# so Cataloggy learns what you finished in Stremio without Trakt relaying it.
# Connect the account from Settings > Stremio Watched Sync; nothing is needed
# here to enable it.
#
# How often to check the Stremio library, in seconds. Off by default: play
# detection below covers every addon-consuming client, so the library poll is
# for people who want Stremio's own exact watched state instead of an
# inference. The one-time import works either way. 120 is a sensible value if
# you turn it on — a check costs one small request when nothing has been
# watched.
STREMIO_POLL_INTERVAL_SEC=0
# Only set this if you point Stremio clients at your own account server. Must
# be https:// — the first request carries your Stremio password, and every one
# after it carries the key that stands in for it. A path prefix is kept, so
# https://host/stremio works.
STREMIO_API_BASE=https://api.strem.io

# Play detection: infer watches from what addon-consuming clients ask the addon
# for. This is the only automatic signal available from clients that keep their
# library to themselves (Vidi, Omni, Nuvio and similar) — the addon protocol
# never reports what was watched, so a `stream` or `subtitles` request is
# treated as "about to watch this" and becomes a watch only once the title's
# runtime has elapsed without being contradicted.
#
# It infers rather than observes, so it is off by default. Set on BOTH the api
# and addon services — the addon observes, the api decides.
STREMIO_PLAY_DETECTION=false

# IGDB game search/metadata, via Twitch's developer console (IGDB auth rides
# on a Twitch app). Leaving these unset is safe; the Games search-to-add
# endpoint returns a clear error message.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Steam library import (playtime, recently-played) for the Games section.
# STEAM_API_KEY: https://steamcommunity.com/dev/apikey
# STEAM_ID: your 17-digit SteamID64, e.g. from https://steamid.io
# Leaving these unset disables Steam sync; manually-added games still work.
STEAM_API_KEY=
STEAM_ID=

# How often the Steam library sync runs, in seconds. Defaults to once a day
# (86400). Set to 0 to disable the scheduled sync (manual sync via the
# Games UI still works).
STEAM_SYNC_INTERVAL_SEC=

# Shared secret required by the Plex/Jellyfin webhook endpoints. Leaving
# this unset disables those endpoints (they reject all requests).
# Generate one with: openssl rand -hex 32
#
# SECURITY: Plex/Jellyfin do not sign their webhook requests, so this
# shared secret is the only verification available (no HMAC signature to
# check). Do NOT expose /webhooks/plex or /webhooks/jellyfin to the public
# internet — keep them reachable only from your LAN or reverse-proxy-
# internal network, alongside Plex/Jellyfin themselves.
WEBHOOK_SECRET=

# Optional, recommended if the API is reachable from outside your LAN (e.g.
# via a reverse proxy): comma-separated list of source IPs allowed to call
# /webhooks/plex and /webhooks/jellyfin (the IPs of your Plex/Jellyfin
# servers). Requests from any other IP are rejected before the webhook
# secret is even checked. Leave unset to allow any IP (relying solely on
# WEBHOOK_SECRET). Requires TRUST_PROXY to be configured correctly so
# request IPs aren't the reverse proxy's own address.
WEBHOOK_ALLOWED_IPS=

# Optional: which profile a Plex/Jellyfin scrobble lands in. By default the
# webhook matches the media server's account name against your Cataloggy
# profile names (case-insensitive) and falls back to the default profile if
# nothing matches. To pin a webhook to a specific profile instead, append
# ?profile=<profile-uuid> to the webhook URL you configure in Plex/Jellyfin
# (alongside the ?token= secret) — useful when the account names differ.

# Maximum request body the API accepts, in MB. The default covers a library
# export of roughly 200k watch events; raise it if restoring your own backup
# is rejected with a 413. The body is buffered in memory, so this is a real
# ceiling, not a formality. Defaults to 32. Independently of this, an import
# is capped at 200,000 rows per collection (watch events, ratings, list items,
# series progress, or CSV rows) — 10,000 for Letterboxd exports, which cost a
# TMDB search per title. Split a larger file and import it in parts.
MAX_BODY_SIZE_MB=

# Contact address sent to push services (Chrome FCM, Mozilla Push) to
# identify this server. Defaults to mailto:admin@cataloggy.local.
VAPID_SUBJECT=

# How often tracked shows are checked for new episodes, in seconds.
# Defaults to hourly (3600). Set to 0 to disable episode notifications
# entirely — the API logs that it has done so at startup.
NOTIFICATION_CHECK_INTERVAL_SEC=

# Log level for the addon service: fatal, error, warn, info (default),
# debug, trace or silent.
LOG_LEVEL=

# Optional: DSN of a Sentry project (or compatible error-tracking service)
# to report unhandled errors from the api, addon, and web services. Leaving
# this unset disables error tracking entirely — no data leaves your server.
SENTRY_DSN=

# ── Other Postgres settings ────────────────────────────────────────────────

POSTGRES_DB=cataloggy
POSTGRES_USER=postgres
