# Copy this file to .env (next to docker-compose.yml) and fill in real values
# before running `docker compose up`. See README.md for full details.

# ── Required ──────────────────────────────────────────────────────────────

# Shared bearer token used by the api and addon services to authenticate
# requests. Generate one with: openssl rand -hex 32
API_TOKEN=

# Postgres password for the db service. Must not be left as the old
# "postgres" development default in production.
POSTGRES_PASSWORD=

# ── Recommended for LAN devices (phone / Apple TV / Android TV) ───────────

# Replace 192.168.1.25 below with your machine's LAN IP (see README.md
# "Find your LAN IP").
CATALOGGY_ALLOWED_ORIGINS=http://192.168.1.25:7002
CATALOGGY_API_PUBLIC=http://192.168.1.25:7000
CATALOGGY_WEB_PUBLIC=http://192.168.1.25:7002
ADDON_PUBLIC_BASE=http://192.168.1.25:7001
VITE_API_BASE=http://192.168.1.25:7000
VITE_ADDON_BASE=http://192.168.1.25:7001

# ── Optional: custom domain (e.g. behind Nginx Proxy Manager) ─────────────

# Comma-separated hostnames allowed to reach the web server, beyond
# IPs/localhost (which are always allowed).
ALLOWED_HOSTS=

# ── Optional integrations ──────────────────────────────────────────────────

TMDB_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=

# IGDB game search/metadata, via Twitch's developer console (IGDB auth rides
# on a Twitch app). Leaving these unset is safe; the Games search-to-add
# endpoint returns a clear error message.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Steam library import (playtime, recently-played) for the Games section.
# STEAM_API_KEY: https://steamcommunity.com/dev/apikey
# STEAM_ID: your 17-digit SteamID64, e.g. from https://steamid.io
# Leaving these unset disables Steam sync; manually-added games still work.
STEAM_API_KEY=
STEAM_ID=

# How often the Steam library sync runs, in seconds. Defaults to once a day
# (86400). Set to 0 to disable the scheduled sync (manual sync via the
# Games UI still works).
STEAM_SYNC_INTERVAL_SEC=

# Shared secret required by the Plex/Jellyfin webhook endpoints. Leaving
# this unset disables those endpoints (they reject all requests).
# Generate one with: openssl rand -hex 32
#
# SECURITY: Plex/Jellyfin do not sign their webhook requests, so this
# shared secret is the only verification available (no HMAC signature to
# check). Do NOT expose /webhooks/plex or /webhooks/jellyfin to the public
# internet — keep them reachable only from your LAN or reverse-proxy-
# internal network, alongside Plex/Jellyfin themselves.
WEBHOOK_SECRET=

# Optional, recommended if the API is reachable from outside your LAN (e.g.
# via a reverse proxy): comma-separated list of source IPs allowed to call
# /webhooks/plex and /webhooks/jellyfin (the IPs of your Plex/Jellyfin
# servers). Requests from any other IP are rejected before the webhook
# secret is even checked. Leave unset to allow any IP (relying solely on
# WEBHOOK_SECRET). Requires TRUST_PROXY to be configured correctly so
# request IPs aren't the reverse proxy's own address.
WEBHOOK_ALLOWED_IPS=

# Optional: which profile a Plex/Jellyfin scrobble lands in. By default the
# webhook matches the media server's account name against your Cataloggy
# profile names (case-insensitive) and falls back to the default profile if
# nothing matches. To pin a webhook to a specific profile instead, append
# ?profile=<profile-uuid> to the webhook URL you configure in Plex/Jellyfin
# (alongside the ?token= secret) — useful when the account names differ.

# Maximum request body the API accepts, in MB. The default covers a library
# export of roughly 200k watch events; raise it if restoring your own backup
# is rejected with a 413. The body is buffered in memory, so this is a real
# ceiling, not a formality. Defaults to 32.
MAX_BODY_SIZE_MB=

# Contact address sent to push services (Chrome FCM, Mozilla Push) to
# identify this server. Defaults to mailto:admin@cataloggy.local.
VAPID_SUBJECT=

# Optional: DSN of a Sentry project (or compatible error-tracking service)
# to report unhandled errors from the api, addon, and web services. Leaving
# this unset disables error tracking entirely — no data leaves your server.
SENTRY_DSN=

# ── Other Postgres settings ────────────────────────────────────────────────

POSTGRES_DB=cataloggy
POSTGRES_USER=postgres
