generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  movie
  series
  episode
}

enum ListKind {
  watchlist
  custom
}

enum ListItemType {
  movie
  series
}

enum WatchEventType {
  movie
  episode
}

enum MetadataType {
  movie
  series
}

enum ScrobbleStatus {
  playing
  paused
  stopped
}

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  pinHash   String?
  createdAt DateTime @default(now()) @db.Timestamp(6)

  lists             List[]
  watchEvents       WatchEvent[]
  seriesProgress    SeriesProgress[]
  notifiedEpisodes  NotifiedEpisode[]
  scrobbleSessions  ScrobbleSession[]
  pushSubscriptions PushSubscription[]
  ratings           Rating[]
  checkIn           CheckIn?
}

model Item {
  id           String   @id @default(uuid()) @db.Uuid
  type         ItemType
  imdbId       String
  parentImdbId String?
  season       Int?
  episode      Int?
  title        String?
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@index([imdbId])
  @@unique([type, imdbId])
}

// A partial unique index on kind = 'watchlist' (migration 20260617120000) enforces
// that at most one default watchlist exists. Prisma's schema DSL has no syntax for
// partial unique indexes, so it isn't declared here — don't let `prisma migrate dev`
// generate a migration that drops it.
model List {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  kind      ListKind
  createdAt DateTime   @default(now()) @db.Timestamp(6)
  items     ListItem[]

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ListItem {
  listId  String       @db.Uuid
  type    ListItemType
  imdbId  String
  addedAt DateTime     @default(now()) @db.Timestamp(6)

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, type, imdbId])
  @@index([listId])
}

model WatchEvent {
  id             String         @id @default(uuid()) @db.Uuid
  type           WatchEventType
  imdbId         String
  seriesImdbId   String?
  season         Int?
  episode        Int?
  watchedAt      DateTime       @db.Timestamptz(6)
  dateUnknown    Boolean        @default(false)
  plays          Int            @default(1)
  traktHistoryId BigInt?        @unique

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model SeriesProgress {
  seriesImdbId  String
  lastSeason    Int
  lastEpisode   Int
  lastWatchedAt DateTime @db.Timestamptz(6)
  updatedAt     DateTime @db.Timestamptz(6)

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, seriesImdbId])
  @@index([lastWatchedAt], name: "idx_seriesprogress_lastWatchedAt")
}

model KV {
  key       String   @id
  value     String
  updatedAt DateTime @db.Timestamp(6)
}

model Rating {
  imdbId    String
  type      MetadataType
  rating    Float
  ratedAt   DateTime     @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, type, imdbId])
  @@index([profileId])
}

// A single active check-in per profile — starting a new one replaces it,
// mirroring the previous KV upsert-by-profile behavior.
model CheckIn {
  type         WatchEventType
  imdbId       String
  seriesImdbId String?
  season       Int?
  episode      Int?
  name         String
  poster       String?
  startedAt    DateTime  @db.Timestamptz(6)
  expiresAt    DateTime? @db.Timestamptz(6)

  profileId String  @id @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model NotifiedEpisode {
  id           String   @id @default(uuid()) @db.Uuid
  seriesImdbId String
  season       Int
  episode      Int
  notifiedAt   DateTime @default(now()) @db.Timestamptz(6)

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, seriesImdbId, season, episode])
}

model TraktToken {
  id           String   @id @default("default")
  accessToken  String
  refreshToken String
  expiresAt    DateTime @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
}

model ScrobbleSession {
  id           String          @id @default(uuid()) @db.Uuid
  type         WatchEventType
  imdbId       String
  seriesImdbId String?
  season       Int?
  episode      Int?
  status       ScrobbleStatus  @default(playing)
  progress     Float           @default(0) // 0-100 percentage
  startedAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([imdbId, season, episode, status])
  @@index([profileId])
}

model Metadata {
  imdbId        String
  type          MetadataType
  tmdbId        Int?
  name          String
  year          Int?
  poster        String?
  background    String?
  description   String?      @db.Text
  genres        String[]     @default([])
  rating        Float?
  voteCount     Int?
  totalSeasons  Int?
  totalEpisodes Int?
  imdbRating    Float?
  rtScore       Int?
  mcScore       Int?
  runtime       Int?
  certification String?
  status        String?
  network       String?
  releaseDate   String?
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([imdbId, type])
}
